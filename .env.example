# Copy to .env (gitignored) and fill in. Never commit real values.
# GitHub Actions reads these from repository secrets with the same names.

# Hugging Face token with write access to the fyp-psx-advisor/fyp-data dataset.
HF_TOKEN=

# pyPSX historical data collection credentials. Keep real values in .env only.
PYPSX_API_KEY_ID=your_pypsx_api_key_id_here
PYPSX_API_SECRET_KEY=your_pypsx_api_secret_key_here

# News stream, optional coverage checks only.
NEWSAPI_KEY=
GNEWS_KEY=
