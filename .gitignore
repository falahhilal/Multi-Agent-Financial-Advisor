__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Next.js ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# --- editors and OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- logs ---
*.log
npm-debug.log*

# NOTE: experiments/results/ is deliberately NOT ignored. Ablation, backtest,
# personalisation and survey outputs are committed so every number in the
# thesis is reproducible from a result file, a git SHA and a universe version.
